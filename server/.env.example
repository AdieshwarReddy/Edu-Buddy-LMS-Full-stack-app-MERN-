NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/edubuddy

JWT_SECRET=super_secret_jwt_key_for_development_change_in_production_32chars
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# Cloudinary media storage (Optional for mock fallback / Required for live Cloudinary upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe Payments (Optional for mock / Required for test mode checkout)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
